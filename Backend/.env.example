# ==========================================
# CORE SERVER CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/monietrack?retryWrites=true&w=majority

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
JWT_SECRET=your_super_secret_jwt_key_here

# ==========================================
# MONO BANKING INTEGRATION
# ==========================================
MONO_API_URL=https://api.withmono.com
MONO_SECRET_KEY=your_mono_secret_key
MONO_WEBHOOK_SECRET=your_mono_webhook_secret
MONO_REDIRECT_URL=http://localhost:5173/bank-callback

# Must be EXACTLY 64 hex characters (32 bytes) for AES-256-GCM encryption
BANK_TOKEN_ENCRYPTION_KEY=32_character_long_encryption_key_here

# Backend Example .env file for development purposes. Make sure to replace placeholders with actual values before running the application.
JWT_EXPIRE=30d
