# ==========================================
# CORE SERVER CONFIGURATION
# ==========================================
PORT=5000
MONGO_URI=your_mongodb_connection_string_here
NODE_ENV=development

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
JWT_SECRET=your_jwt_secret_here

# ==========================================
# MONO BANKING INTEGRATION
# ==========================================
MONO_API_URL=https://api.withmono.com
MONO_SECRET_KEY=your_mono_secret_key_here
MONO_WEBHOOK_SECRET=your_mono_webhook_secret_here
MONO_REDIRECT_URL=http://localhost:5173/bank-callback

# Must be EXACTLY 64 hex characters (32 bytes) for AES-256-GCM encryption
BANK_TOKEN_ENCRYPTION_KEY=your_64_character_hex_string_here
