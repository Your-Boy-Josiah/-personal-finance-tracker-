Install the REST Client extension in VS Code to run this file.

@baseUrl = http://localhost:5000/api
@token = PASTE_YOUR_JWT_TOKEN_HERE
@categoryId = 6ab53a90ded84627f91309d6

### =========================================================================
### 1. AUTHENTICATION
### Log in to generate a new JWT Token. Paste the returned token into the 
### @token variable at the top of this file.
### =========================================================================

POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "josiah.test@example.com",
  "password": "Password123!"
}


### =========================================================================
### 2. CREATE OR UPDATE BUDGET
### Creates a monthly budget with a spending cap on the selected category.
### =========================================================================

PUT {{baseUrl}}/budget
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "monthlyIncome": 800000,
  "incomeFrequency": "monthly",
  "currency": "NGN",
  "categoryLimits": [
    {
      "category": "{{categoryId}}",
      "spendingCap": 10000
    }
  ]
}


### =========================================================================
### 3. GET CURRENT BUDGET
### Retrieves the user's budget and populated category rules.
### =========================================================================

GET {{baseUrl}}/budget
Authorization: Bearer {{token}}


### =========================================================================
### 4. RECORD MOCK EXPENSE TRANSACTION
### Logs a transaction. Modify the amount to test over/under budget scenarios.
### =========================================================================

POST {{baseUrl}}/transactions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "type": "expense",
  "amount": 15000,
  "category": "{{categoryId}}",
  "description": "Monthly Software Subscriptions",
  "transactionDate": "2026-09-24T15:00:00.000Z"
}


### =========================================================================
### 5. GET FINANCIAL ADVISORY
### Generates real-time gamified advice based on the month's spending vs caps.
### =========================================================================

GET {{baseUrl}}/budget/advisory
Authorization: Bearer {{token}}

### =========================================================================
### 6. REGISTER NEW USER (Optional)
### Creates a fresh account. Useful if you want to test default states.
### =========================================================================

POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "firstName": "New",
  "lastName": "User",
  "email": "new.user@example.com",
  "password": "Password123!"
}


### =========================================================================
### 7. GET ALL CATEGORIES
### Fetches default global system categories and your custom categories.
### =========================================================================

GET {{baseUrl}}/categories
Authorization: Bearer {{token}}


### =========================================================================
### 8. CREATE CUSTOM CATEGORY
### Creates a new category. Copy the returned "_id" and paste it into the 
### @categoryId variable at the top of this file to use in other requests.
### =========================================================================

POST {{baseUrl}}/categories
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Dining",
  "type": "expense",
  "color": "#FF5733"
}


### =========================================================================
### 9. DELETE CATEGORY (ACID CASCADE TEST - TASK E-2)
### Deletes the category matching @categoryId and safely reassigns any 
### linked transactions to the "Uncategorized" bucket.
### =========================================================================

DELETE {{baseUrl}}/categories/{{categoryId}}
Authorization: Bearer {{token}}


### =========================================================================
### 10. GET ALL TRANSACTIONS
### Retrieves your transaction history. Run this before and after deleting 
### a category to verify the transaction was reassigned, not deleted.
### =========================================================================

GET {{baseUrl}}/transactions
Authorization: Bearer {{token}}
